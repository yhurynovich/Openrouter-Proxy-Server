# ============================================================
# OpenRouter Proxy Server — Environment Configuration
# Copy this file to .env and adjust values as needed.
# ============================================================

# ---- Server ----
PORT=3000                                # Server listen port
ADMIN_SECRET=your-admin-secret           # Secret for /admin/* endpoints (required for admin API)

# ---- Request Limits ----
BODY_LIMIT=50mb                          # Max request body size (large tool schemas + context)
MAX_MESSAGE_LENGTH=100000                # Max characters per message in a request

# ---- Rate Limiting (per-client) ----
RATE_LIMIT_WINDOW_MS=60000               # Sliding window in ms
RATE_LIMIT_MAX=100                       # Max requests per window per IP

# ---- Rate Limiting (admin endpoints, stricter) ----
ADMIN_RATE_LIMIT_WINDOW_MS=60000
ADMIN_RATE_LIMIT_MAX=10

# ---- Upstream Connection (Axios / OpenRouter) ----
AXIOS_TIMEOUT=300000                       # Per-request timeout (ms) - 5 min for long agent tasks
AXIOS_MAX_SOCKETS=50                       # Max concurrent sockets per host
AXIOS_MAX_FREE_SOCKETS=10                  # Max keep-alive sockets in pool
AXIOS_KEEPALIVE_TIMEOUT=300000             # Keep-alive timeout (ms) - 5 min
AXIOS_FREE_SOCKET_TIMEOUT=60000            # Free socket timeout (ms) - 1 min
AXIOS_IDLE_TIMEOUT=300000                  # Idle timeout for upstream connections (ms) - 5 min

# ---- DNS Configuration ----
# Comma-separated DNS servers used to resolve openrouter.ai.
# Set this when the container's default DNS is broken (common in Docker on Synology NAS).
# Leave empty to use the system default.
OPENROUTER_DNS_SERVERS=

# Timeout for DNS lookups (ms). Prevents indefinite hangs during resolution.
# A DNS_LOOKUP_TIMEOUT error triggers a retry just like other network errors.
DNS_LOOKUP_TIMEOUT_MS=5000

# ---- Retry Settings ----
MAX_RETRIES=10                             # Max total retry attempts (rate limit + network)
MAX_RATE_LIMIT_RETRIES=10                  # Max retries specifically for rate limit (429) responses
RETRY_DELAY_MS=2000                        # Base delay between retries (ms)
TOTAL_REQUEST_TIMEOUT_MS=600000            # Hard cap on total request time incl. retries (ms) - 10 min

# ---- Models Endpoint ----
MODELS_TIMEOUT=30000                     # Timeout for fetching model list (ms)

# ---- OpenRouter Identification ----
HTTP_REFERER=http://localhost:3000       # Referer header sent to OpenRouter
SITE_NAME=OpenRouterProxy                # Site title sent to OpenRouter (X-Title)

# ---- SSE / Streaming ----
SSE_BUFFER_LIMIT=10485760                # Max buffer size for streaming responses (bytes, ~10MB)

# ---- Key Manager ----
KEY_MAX_ROTATION_DEPTH=3                 # Max key rotation recursion depth
KEY_MAX_FAILURE_COUNT=5                  # Failures before a key is deactivated
KEY_REACTIVATION_FAILURE_REDUCTION=2      # Failure-count reduction on bulk reactivation
KEY_BASE_RETRY_DELAY_MS=1000             # Base delay for exponential backoff (ms)
KEY_MAX_RETRY_DELAY_MS=30000             # Capped max delay for exponential backoff (ms)

# ---- Model Failover ----
# When a model fails (overloaded, 5xx, or rate-limited across all keys),
# the request is retried with the next model in the group.
# The system tries other API accounts first (full key rotation) before switching models.
# JSON array of arrays: each inner array is an ordered group of interchangeable models.
# Example: [["deepseek/deepseek-chat:free","meta-llama/llama-3.1-8b-instruct:free","qwen/qwen-2.5-72b-instruct:free"]]
MODEL_FAILOVER_GROUPS=
MAX_MODEL_FAILOVERS=0                    # Max model switches per request (0 = unlimited)

# ---- Tool / Function Calling Limits ----
# Max tools allowed in a single chat completion request.
# Agent frameworks (OpenHands, Aider, etc.) often register 50-200 tools.
# Increase if you see "tools: exceeds maximum count of 100" errors.
MAX_TOOL_CALLS=250                       # Default: 100, max: 10000

# ---- Logging (alternative to config/logger.json) ----
# Note: These can also be set in config/logger.json. Env vars take precedence if set.
LOG_LEVEL=warning                        # error | warning | info | debug
LOG_RETENTION_DAYS=14                    # Log file retention in days
